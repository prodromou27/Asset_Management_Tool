# Copy to .env at the repository root and fill in local values. Never commit .env.
# scripts/compose.sh always passes this file to Docker Compose via --env-file.

ITAM_ENV=development
ITAM_PUBLIC_URL=http://localhost:5173
ITAM_ALLOWED_HOSTS=localhost,127.0.0.1
ITAM_TIMEZONE=Asia/Nicosia
ITAM_LOG_LEVEL=INFO

POSTGRES_DB=itam
POSTGRES_USER=itam
# Required. Choose a local-only value; there is no committed default.
POSTGRES_PASSWORD=

# Required. Production refuses keys shorter than 50 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Production only (compose.prod.yaml): directory containing fullchain.pem and
# privkey.pem for the reverse proxy. Production also requires explicit
# ITAM_ALLOWED_HOSTS (no "*") and ITAM_ENV=production.
ITAM_TLS_CERT_DIR=

# Integrations (Task 006). Live source access stays OFF until the Docker-host
# verification has passed and a read-only LibreNMS API account is approved.
ITAM_ALLOW_LIVE_INTEGRATIONS=false
# Read-only LibreNMS API token. Reference it on the integration page as
# env:ITAM_INTEGRATION_LIBRENMS_TOKEN. Leave empty until approved.
ITAM_INTEGRATION_LIBRENMS_TOKEN=
# Read-only Endpoint Central (on-premises) API key with inventory read access only.
# Reference it as env:ITAM_INTEGRATION_ENDPOINT_CENTRAL_KEY. Leave empty until approved.
ITAM_INTEGRATION_ENDPOINT_CENTRAL_KEY=
# Microsoft Intune (Graph) app registration client secret, only if a certificate cannot
# be used. Reference it as env:ITAM_INTEGRATION_INTUNE_CLIENT_SECRET. The preferred
# credential is a certificate PEM file in ITAM_SECRETS_DIR (file:<name>). Tenant and
# application IDs are entered on the integration page. Leave empty until DEC-07 is approved.
ITAM_INTEGRATION_INTUNE_CLIENT_SECRET=
